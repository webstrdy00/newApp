# Direct backend local values.
# Use this when running FastAPI from the backend directory outside Docker.
ENVIRONMENT=local

DATABASE_URL=postgresql+psycopg://haemeoknote:haemeoknote@localhost:5433/haemeoknote

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=haemeoknote
MINIO_SECURE=false

API_CORS_ORIGINS=["*"]
API_PUBLIC_BASE_URL=http://localhost:8000/api

IMAGE_UPLOAD_MAX_BYTES=10485760
IMAGE_UPLOAD_ALLOWED_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]

JWT_SECRET_KEY=change-me-in-production-with-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FILE_ACCESS_TOKEN_EXPIRE_MINUTES=60
